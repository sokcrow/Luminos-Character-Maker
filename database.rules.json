{
  "rules": {
    "campaña": {
      ".read": "auth != null",

      "estado_mundo": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "clima": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "worldData": {
        "weatherForecast": {
          ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
        }
      },

      "hora_actual": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "config": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "actores": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "base_datos_npcs": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "escenarios": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "calendario": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      },

      "jugadores": {
        "$nombre_personaje": {
          ".write": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || !data.child('uid').exists() || data.child('uid').val() === auth.uid)"
        }
      },

      "teatro": {
        ".write": "auth != null"
      }
    },

    "dm_private": {
      ".read": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'",
      "theatre_rolls": {
        "$room": {
          "$rollId": {
            ".write": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || (!data.exists() && newData.child('rollerUid').val() === auth.uid && newData.child('privateRoomKey').val() === $room))"
          }
        }
      }
    },

    "theatre_check_requests": {
      ".read": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'",
      "$requestId": {
        ".read": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || data.child('requesterUid').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || (!data.exists() && newData.child('requesterUid').val() === auth.uid))"
      }
    },

    "theatre_check_commands": {
      "$uid": {
        ".read": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || auth.uid === $uid)",
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      }
    },

    "theatre_check_live": {
      ".read": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'",
      "$uid": {
        ".read": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || auth.uid === $uid)",
        "$commandId": {
          ".write": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || auth.uid === $uid)"
        }
      }
    },

    "theatre_opposed_checks": {
      ".read": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'",
      "$sessionId": {
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'",
        "thresholdResult": {
          ".write": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || (!data.exists() && root.child('theatre_opposed_checks').child($sessionId).child('rivalUid').val() === auth.uid && newData.child('uid').val() === auth.uid))"
        },
        "resolverResult": {
          ".write": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || (!data.exists() && root.child('theatre_opposed_checks').child($sessionId).child('initiatorUid').val() === auth.uid && newData.child('uid').val() === auth.uid))"
        }
      }
    },

    "theatre_opposed_results": {
      "$uid": {
        ".read": "auth != null && (auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1' || auth.uid === $uid)",
        ".write": "auth != null && auth.uid === 'e9JwFZrtk6g8UMqq2Hf9EHVY7Ay1'"
      }
    }
  }
}
